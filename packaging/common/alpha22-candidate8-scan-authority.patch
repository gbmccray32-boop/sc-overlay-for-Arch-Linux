+// ARCHVERSE_LINUX_SCAN_MODE_TEMPORAL_AUTHORITY: require repeat evidence at the same radar
+// location, then keep a short latch through individual dropped frames. One-frame HUD coincidences
+// cannot arm Mining, while a real persistent Scan Mode does not flicker on a single missed frame.
+function createScanModeAuthorityStabilizer(options = {}) {
+  const confirmHits = Math.max(2, Number(options.confirmHits) || 2);
+  const confirmWindowMs = Math.max(1000, Number(options.confirmWindowMs) || 4500);
+  const latchMs = Math.max(1000, Number(options.latchMs) || 4500);
+  const maxDx = Number(options.maxDx) || 0.008;
+  const maxDy = Number(options.maxDy) || 0.012;
+  let hits = 0;
+  let lastHitAt = 0;
+  let lastRoi = null;
+  let latchedUntil = 0;
+  let lastAccepted = null;
+  return (raw, now = Date.now()) => {
+    raw = raw && typeof raw === "object" ? raw : { active: false, confidence: 0, method: "radar-icon-structure-search" };
+    if (raw.active && raw.roi && Number.isFinite(raw.roi.x) && Number.isFinite(raw.roi.y)) {
+      const same = lastRoi && now - lastHitAt <= confirmWindowMs
+        && Math.abs(raw.roi.x - lastRoi.x) <= maxDx
+        && Math.abs(raw.roi.y - lastRoi.y) <= maxDy;
+      hits = same ? hits + 1 : 1;
+      lastHitAt = now;
+      lastRoi = { x: raw.roi.x, y: raw.roi.y };
+      if (hits >= confirmHits) {
+        latchedUntil = now + latchMs;
+        lastAccepted = { ...raw, active: true, authorityStable: true, authorityHits: hits };
+        return lastAccepted;
+      }
+      return { ...raw, active: false, confidence: 0, authorityStable: false, authorityHits: hits,
+        rejectionReason: "temporal-consistency" };
+    }
+    if (lastAccepted && now <= latchedUntil) {
+      return { ...lastAccepted, active: true, method: "radar-icon-structure-latch", authorityStable: true,
+        authorityHits: hits, latched: true };
+    }
+    if (now - lastHitAt > confirmWindowMs) { hits = 0; lastRoi = null; }
+    return { ...raw, active: false, authorityStable: false, authorityHits: hits };
+  };
+}
