#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SELF")/.." && pwd)"
export SC_TRACKER_WIDGET_WINDOWS=preview
export SC_TRACKER_CONFIG_DIR="${SC_TRACKER_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/sc-blueprint-tracker}"
mkdir -p -- "$SC_TRACKER_CONFIG_DIR"
LOG_FILE="$SC_TRACKER_CONFIG_DIR/electron.log"
printf '%s\n' '[widget-window] launching Candidate 19 Log native-window preview; all other widgets remain on the canvas' | tee "$LOG_FILE" >&2
set +e
"$ROOT/bin/sc-blueprint-tracker" "$@" 2>&1 | tee -a "$LOG_FILE"
status=${PIPESTATUS[0]}
set -e
exit "$status"
